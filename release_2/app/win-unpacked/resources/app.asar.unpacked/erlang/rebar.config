
{erl_opts, [debug_info, {warn_unused_vars, true}, {warn_unused_import, true}, {warn_export_all, false}]}.
{deps, [
    {cowboy, "2.12.0"},
    {jsx, "3.1.0"}
]}.
{plugins, [rebar3_hex, rebar3_dialyzer]}.
{relx, [{release, {helpy_plan, "1.0.0", [{helpy_plan, "1.0.0"}]}]}.
{dialyzer, [{warnings, [error_handling, race_conditions, unmatched_returns, underspecs]}]}.
{eunit_opts, [{report, {eunit_surefire, [{dir, "_build/test/cover"}]}}]}.

